# ── Python ───────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
*.whl
pip-log.txt
pip-delete-this-directory.txt

# ── Virtual Environments ─────────────────────────────────────────────
.env
.venv/
venv/
env/
ENV/

# ── Jupyter ──────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.nbconvert/
profile_default/
ipython_config.py

# ── PySpark / Java ───────────────────────────────────────────────────
derby.log
metastore_db/
spark-warehouse/
*.log
hs_err_pid*
replay_pid*
catboost_info/

# ── Notebook scratch / duplicate outputs ─────────────────────────────
notebooks/artifacts/
notebooks/models/

# ── Local caches (including repository-local Hugging Face caches) ────
.cache/
*.arrow
*.parquet.tmp

# ── Generated data, artifacts, reports, and experiment logs ───────────
# These are produced by notebooks 01-04 or scripts/prepare_data.py and must
# be regenerated when code/config/notebooks change (not bundled in git).
processed/
artifacts/
reports/figures/
reports/metrics/
mlruns/

# ── Configs with secrets ─────────────────────────────────────────────
configs/secrets.yaml
configs/*.local.yaml
*.env
.env.*
configs/.env

# ── OS ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Testing ──────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── Streamlit ────────────────────────────────────────────────────────
.streamlit/secrets.toml
.streamlit/*.log

# ── DVC (data version control - optional) ────────────────────────────
.dvc/tmp/
.dvc/cache/
/tmp/

# ── Notebook output / scratch ────────────────────────────────────────
*.nbconvert.py

# ── Pre-commit (root .pre-commit-config.yaml is tracked) ─────────────
*.pre-commit-config.yaml.local

# ── Windows-specific ─────────────────────────────────────────────────
$RECYCLE.BIN/
*.lnk