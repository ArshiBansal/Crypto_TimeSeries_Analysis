# ── IDE ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.code-workspace

# ── Python ───────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
*.whl
pip-log.txt
pip-delete-this-directory.txt

# ── Virtual Environments ─────────────────────────────────────────────
.env
.venv/
venv/
env/
ENV/

# ── Jupyter ──────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.nbconvert/
profile_default/
ipython_config.py

# ── PySpark / Java ───────────────────────────────────────────────────
derby.log
metastore_db/
spark-warehouse/
*.log

# ── HuggingFace cache (datasets fetched via library – never stored here) ──
~/.cache/huggingface/
.cache/
*.arrow
*.parquet.tmp

# ── Processed data & artifacts (large files – tracked via DVC if needed) ──
processed/
artifacts/
reports/figures/
reports/metrics/

# ── Configs with secrets ─────────────────────────────────────────────
configs/secrets.yaml
configs/*.local.yaml
*.env
.env.*
configs/.env

# ── OS ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Testing ──────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── Streamlit ────────────────────────────────────────────────────────
# Keep .streamlit/config.toml (theme/server settings — safe to commit)
# Ignore secrets file which may contain API keys
.streamlit/secrets.toml

# ── Streamlit Cloud deployment cache ─────────────────────────────────
.streamlit/*.log

# ── DVC (data version control – optional) ────────────────────────────
.dvc/tmp/
.dvc/cache/
/tmp/

# ── Notebook output / scratch ────────────────────────────────────────
# Notebook source is committed; large cell outputs are cleared before push
# (use `jupyter nbconvert --clear-output` or nbstripout pre-commit hook)
*.nbconvert.py

# ── Windows-specific ─────────────────────────────────────────────────
$RECYCLE.BIN/
*.lnk

